# Puerto donde escucha la API
PORT=3000
# Orígenes permitidos para CORS (URLs del frontend con Vite), separados por coma
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Conexión a MySQL (copia este archivo como .env y pon tus datos)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=taller_servicio_tecnico

# Autenticación (JWT): genera una clave larga y aleatoria, por ejemplo con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Agente de IA (opcional). Sin API key, el asistente aparece desactivado y el resto funciona igual.
# Crea tu clave en https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
AGENTE_MODELO=claude-opus-5-5
# Nivel de esfuerzo del modelo: low (más rápido y económico), medium o high
AGENTE_ESFUERZO=low

# URL del frontend (para los enlaces de los correos) y zona horaria de los informes
APP_URL=http://localhost:5173
ZONA_HORARIA=America/Guayaquil

# Correo con Gmail: activa la verificación en dos pasos de tu cuenta de Google y crea una
# "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# Sin SMTP_USER/SMTP_PASS los correos se simulan (se ven en Administración → Correos).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Inicio de sesión con Google (opcional): ID de cliente OAuth de tipo "Aplicación web"
# creado en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
