{
  "info": {
    "name": "Bancada · Mini Proyecto 1 (Taller de servicio técnico)",
    "description": "Ejecuta la colección completa con el Runner (en orden). \"Login OK\" guarda el token en {{token}} y los requests de creación guardan los ids que usan los siguientes. Incluye casos 400, 401, 404 y 409.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "correoPrueba",
      "value": ""
    },
    {
      "key": "sufijo",
      "value": ""
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "ordenId",
      "value": ""
    },
    {
      "key": "componenteId",
      "value": ""
    }
  ],
